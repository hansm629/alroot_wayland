+/* Only called under the opt-in S44 statistics flag. */
+static inline void
+zink_s44_record_timing(struct zink_s44_timing *stats, uint64_t elapsed_ns,
+                       VkResult result)
+{
+   p_atomic_inc(&stats->calls);
+   p_atomic_add(&stats->total_ns, elapsed_ns);
+   uint64_t previous = p_atomic_read(&stats->max_ns);
+   while (previous < elapsed_ns) {
+      uint64_t seen = p_atomic_cmpxchg(&stats->max_ns, previous, elapsed_ns);
+      if (seen == previous)
+         break;
+      previous = seen;
+   }
+   if (result == VK_TIMEOUT)
+      p_atomic_inc(&stats->timeouts);
+   else if (result != VK_SUCCESS)
+      p_atomic_inc(&stats->errors);
+}
