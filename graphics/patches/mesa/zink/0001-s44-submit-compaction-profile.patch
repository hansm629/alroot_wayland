+static inline VkResult
+zink_s44_queue_submit(struct zink_screen *screen, VkQueue queue,
+                      uint32_t count, const VkSubmitInfo *submits)
+{
+   if (!screen->s44_submit_stats)
+      return VKSCR(QueueSubmit)(queue, count, submits, VK_NULL_HANDLE);
+
+   const int64_t start_ns = os_time_get_nano();
+   VkResult result = VKSCR(QueueSubmit)(queue, count, submits, VK_NULL_HANDLE);
+   const uint64_t elapsed_ns = os_time_get_nano() - start_ns;
+   zink_s44_record_timing(&screen->s44_queue_submit, elapsed_ns, result);
+   p_atomic_add(&screen->s44_submit_info_count, count);
+   return result;
+}
