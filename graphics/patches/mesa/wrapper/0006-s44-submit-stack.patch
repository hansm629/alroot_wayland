 #include "vk_util.h"
 #include "util/list.h"
 #include "util/simple_mtx.h"
+#include <pthread.h>
+
+/* Candidate switch and opt-in aggregate accounting are read once per process. */
+static pthread_once_t s44_submit_once = PTHREAD_ONCE_INIT;
+static bool s44_submit_stack;
+static bool s44_submit_profile;
+static uint64_t s44_submit_calls[2];
+static uint64_t s44_submit_stack_calls[2];
+static uint64_t s44_submit_commands;
+static uint64_t s44_submit_heap_calls;
+static uint64_t s44_submit_null_fence_skips;
+
+static void
+s44_submit_init(void)
+{
+   const char *stack = getenv("S44_WRAPPER_SUBMIT_STACK");
+   const char *profile = getenv("S44_WRAPPER_PROFILE");
+   s44_submit_stack = stack && strcmp(stack, "1") == 0;
+   s44_submit_profile = profile && strcmp(profile, "1") == 0;
+}
+
+static bool
+s44_submit_stack_enabled(void)
+{
+   pthread_once(&s44_submit_once, s44_submit_init);
+   return s44_submit_stack;
+}
+
+static void
+s44_submit_count(uint64_t *counter, uint64_t amount)
+{
+   if (s44_submit_profile)
+      __atomic_fetch_add(counter, amount, __ATOMIC_RELAXED);
+}
+
+static void
+s44_submit_report(void)
+{
+   pthread_once(&s44_submit_once, s44_submit_init);
+   if (!s44_submit_profile)
+      return;
+
+#define S44_COUNT(counter) ((unsigned long long)__atomic_load_n(&(counter), __ATOMIC_RELAXED))
+   fprintf(stderr, "S44_WRAPPER_SUBMITS scope=process_cumulative enabled=%u "
+           "submit1=%llu submit2=%llu stack1=%llu stack2=%llu "
+           "commands=%llu heap_calls=%llu null_fence_skips=%llu\n",
+           s44_submit_stack, S44_COUNT(s44_submit_calls[0]),
+           S44_COUNT(s44_submit_calls[1]), S44_COUNT(s44_submit_stack_calls[0]),
+           S44_COUNT(s44_submit_stack_calls[1]), S44_COUNT(s44_submit_commands),
+           S44_COUNT(s44_submit_heap_calls), S44_COUNT(s44_submit_null_fence_skips));
+#undef S44_COUNT
+   fflush(stderr);
+}

