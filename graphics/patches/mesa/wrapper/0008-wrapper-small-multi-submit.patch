+static bool
+s44_submit1_stack_fits(uint32_t count, const VkSubmitInfo *submits)
+{
+   if (count > S44_SUBMIT_STACK_BATCHES)
+      return false;
+   uint32_t remaining = S44_SUBMIT_STACK_COMMANDS;
+   for (uint32_t i = 0; i < count; ++i) {
+      if (submits[i].commandBufferCount > remaining)
+         return false;
+      remaining -= submits[i].commandBufferCount;
+   }
+   return true;
