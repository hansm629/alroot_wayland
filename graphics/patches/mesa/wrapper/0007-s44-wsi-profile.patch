+           "\"image_count\":%u,\"forcesync\":%s,\"sw\":%s,\"blit_type\":%u,"
+           "\"explicit_sync\":%s,\"bridge_shared_calls\":%" PRIu64 "}\n",
+           pid, (const void *)chain, backend, profile->requested_present_mode,
+           (unsigned)chain->present_mode, chain->image_count,
+           chain->wsi->forcesync ? "true" : "false", chain->wsi->sw ? "true" : "false",
+           (unsigned)chain->blit.type, chain->image_info.explicit_sync ? "true" : "false",
+           wsi_s44_load(&profile->bridge_shared_calls));
+   for (unsigned i = 0; i < WSI_S44_SITE_COUNT; ++i) {
+      const struct wsi_s44_stat *stat = &profile->stats[i];
+      fprintf(stderr, "S44_WSI_PROFILE {\"event\":\"stat\",\"pid\":%d,\"chain\":\"%p\","
+              "\"site\":\"%s\",\"calls\":%" PRIu64 ",\"samples\":%" PRIu64 ","
+              "\"total_ns\":%" PRIu64 ",\"max_ns\":%" PRIu64 ",\"clock_errors\":%" PRIu64 ","
+              "\"success\":%" PRIu64 ",\"suboptimal\":%" PRIu64 ",\"timeout\":%" PRIu64 ","
+              "\"not_ready\":%" PRIu64 ",\"error\":%" PRIu64 ",\"other\":%" PRIu64 ",\"hist_log2_us\":[",
+              pid, (const void *)chain, names[i], wsi_s44_load(&stat->calls),
+              wsi_s44_load(&stat->samples), wsi_s44_load(&stat->total_ns),
+              wsi_s44_load(&stat->max_ns), wsi_s44_load(&stat->clock_errors),
+              wsi_s44_load(&stat->success), wsi_s44_load(&stat->suboptimal),
+              wsi_s44_load(&stat->timeout), wsi_s44_load(&stat->not_ready),
+              wsi_s44_load(&stat->error), wsi_s44_load(&stat->other));
+      for (unsigned b = 0; b < WSI_S44_HIST_BINS; ++b)
