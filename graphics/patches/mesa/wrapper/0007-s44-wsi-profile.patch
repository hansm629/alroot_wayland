+/* SPDX-License-Identifier: MIT */
+/* Optional diagnostic counters only: no wait, result, or scheduling changes.
+ * Histogram bin 0 is [0,1) us; bin n is [2^(n-1),2^n) us, with the last
+ * bin also containing larger values. Timers are inclusive wall time, not GPU
+ * time. Nested sites and shared multi-swapchain bridge spans must not be added.
+ */
+#ifndef WSI_S44_PROFILE_H
+#define WSI_S44_PROFILE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <time.h>
+
+enum wsi_s44_site {
+   WSI_S44_ACQUIRE,
+   WSI_S44_THROTTLE,
+   WSI_S44_BRIDGE_SUBMIT,
+   WSI_S44_BLIT_SUBMIT,
+   WSI_S44_FORCED_READY,
+   WSI_S44_BACKEND_PRESENT,
+   WSI_S44_WL_AHB_READY,
+   WSI_S44_X11_WORKER_READY,
+   WSI_S44_SITE_COUNT,
+};
+
+#define WSI_S44_HIST_BINS 24
+
+struct wsi_s44_stat {
+   uint64_t calls, samples, total_ns, max_ns, clock_errors;
+   uint64_t success, suboptimal, timeout, not_ready, error, other;
+   uint64_t hist[WSI_S44_HIST_BINS];
+};
+
+struct wsi_s44_profile {
+   /* Immutable after swapchain initialization, before workers are started. */
+   bool enabled;
+   uint32_t backend, requested_present_mode;
+   uint64_t bridge_shared_calls;
+   struct wsi_s44_stat stats[WSI_S44_SITE_COUNT];
+};
+
+struct wsi_s44_stamp {
+   uint64_t ns;
+   bool valid;
+};
+
+static inline struct wsi_s44_stamp
+wsi_s44_now(bool enabled)
+{
+   struct wsi_s44_stamp stamp = {0, false};
+   if (enabled) {
+      struct timespec ts;
+      if (clock_gettime(CLOCK_MONOTONIC, &ts) == 0 &&
+          ts.tv_sec >= 0 && ts.tv_nsec >= 0 && ts.tv_nsec < 1000000000) {
+         stamp.ns = (uint64_t)ts.tv_sec * UINT64_C(1000000000) + ts.tv_nsec;
+         stamp.valid = true;
+      }
+   }
+   return stamp;
+}
+
+static inline struct wsi_s44_stamp
+wsi_s44_elapsed(struct wsi_s44_stamp start, bool enabled)
+{
+   struct wsi_s44_stamp span = {0, false};
+   if (enabled && start.valid) {
+      struct wsi_s44_stamp end = wsi_s44_now(true);
+      if (end.valid && end.ns >= start.ns) {
+         span.ns = end.ns - start.ns;
+         span.valid = true;
+      }
+   }
+   return span;
+}
+
+static inline uint64_t
+wsi_s44_load(const uint64_t *value)
+{
+   return __atomic_load_n(value, __ATOMIC_RELAXED);
+}
+
+static inline void
+wsi_s44_record(struct wsi_s44_profile *profile, enum wsi_s44_site site,
+               struct wsi_s44_stamp span, VkResult result)
+{
+   if (!profile->enabled)
+      return;
+   struct wsi_s44_stat *stat = &profile->stats[site];
+   __atomic_fetch_add(&stat->calls, 1, __ATOMIC_RELAXED);
+   uint64_t *outcome = result == VK_SUCCESS ? &stat->success :
+      result == VK_SUBOPTIMAL_KHR ? &stat->suboptimal :
+      result == VK_TIMEOUT ? &stat->timeout :
+      result == VK_NOT_READY ? &stat->not_ready :
+      result < 0 ? &stat->error : &stat->other;
+   __atomic_fetch_add(outcome, 1, __ATOMIC_RELAXED);
+   if (!span.valid) {
+      __atomic_fetch_add(&stat->clock_errors, 1, __ATOMIC_RELAXED);
+      return;
+   }
+   __atomic_fetch_add(&stat->samples, 1, __ATOMIC_RELAXED);
+   __atomic_fetch_add(&stat->total_ns, span.ns, __ATOMIC_RELAXED);
+   uint64_t maximum = wsi_s44_load(&stat->max_ns);
+   while (span.ns > maximum &&
+          !__atomic_compare_exchange_n(&stat->max_ns, &maximum, span.ns,
+                                       true, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {}
+   uint64_t us = span.ns / 1000;
+   unsigned bin = 0;
+   while (us && bin < WSI_S44_HIST_BINS - 1) {
+      ++bin;
+      us >>= 1;
+   }
+   __atomic_fetch_add(&stat->hist[bin], 1, __ATOMIC_RELAXED);
+}
+
+static inline void
+wsi_s44_end(struct wsi_s44_profile *profile, enum wsi_s44_site site,
+            struct wsi_s44_stamp start, VkResult result)
+{
+   if (profile->enabled)
+      wsi_s44_record(profile, site, wsi_s44_elapsed(start, true), result);
+}
+
+#endif
