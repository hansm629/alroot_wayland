+static _Thread_local bool s26_retryable_dri3_pixmap_error;
+static atomic_bool s26_injected_pixmap_error = ATOMIC_VAR_INIT(false);
+static atomic_uint s26_test_pixmap_import_count = ATOMIC_VAR_INIT(0);
+
+static bool
+s26_exact_optin(const char *name)
+{
+   const char *value = getenv(name);
+   return value && value[0] == '1' && value[1] == '\0';
+}
+#endif
