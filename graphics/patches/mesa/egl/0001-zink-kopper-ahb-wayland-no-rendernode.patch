+    *
+    * Do NOT set LIBGL_ALWAYS_SOFTWARE: that asks Zink for a CPU Vulkan GPU
+    * and fails on real mobile hardware. Leave the Vulkan device choice to
+    * the active ICD. This opt-in adapter is not tied to Adreno/KGSL and
+    * does not alter X11/DRI3 or other Wayland compositors. The Alroot
+    * runner must first verify alroot_gpu_buffer_v1 on the server.
+    * Backward compatibility is the upstream logic below. */
+   if (disp->Options.Zink && !disp->Options.ForceSoftware &&
+       debug_get_bool_option("ALROOT_EGL_WAYLAND_KOPPER", false))
+      return dri2_initialize_wayland_swrast(disp);
+
    if (disp->Options.ForceSoftware)
