+#ifdef XWL_HAS_GLAMOR
+static Bool
+s28_is_optin_xcb_gpu_window(WindowPtr window, struct xwl_screen *xwl_screen)
+{
+    const char *opt = getenv("S28_KGSL_RESIZE_PRESERVE");
+    if (!opt || opt[0] != '1' || opt[1] != '\0' ||
+        xwl_screen->rootless || !xwl_screen->glamor ||
+        !xwl_glamor_is_kgsl_surfaceless(xwl_screen) ||
+        window == window->drawable.pScreen->root)
+        return FALSE;
+
+    /* Standard Mesa Vulkan XCB WSI tags its swapchain window. The native
+     * XFCE WM's decorations, redirected desktop and regular GTK widgets
+     * must never acquire an artificial resized content frame. */
+    Atom atom = MakeAtom("_MESA_DRV", 9, FALSE);
+    PropertyPtr prop = NULL;
+    return atom != None &&
+           dixLookupProperty(&prop, window, atom, serverClient,
+                             DixReadAccess) == Success &&
+           prop && prop->format == 8 && prop->size > 0;
+}
+
+static Bool
+s28_scale_picture_pixmap(PixmapPtr old_pix, PixmapPtr new_pix)
+{
+    if (!old_pix || !new_pix || old_pix == new_pix ||
+        old_pix->drawable.depth != new_pix->drawable.depth ||
+        old_pix->drawable.width < 30 || old_pix->drawable.height < 30 ||
+        new_pix->drawable.width < 30 || new_pix->drawable.height < 30 ||
+        old_pix->drawable.width > 1920 || old_pix->drawable.height > 1080 ||
+        new_pix->drawable.width > 1920 || new_pix->drawable.height > 1080)
+        return FALSE;
+    ScreenPtr screen = old_pix->drawable.pScreen;
+    int depth = old_pix->drawable.depth;
+    if (depth != 24 && depth != 32) return FALSE;
+    PictFormatPtr f = PictureMatchFormat(screen, depth,
+                         depth == 32 ? PICT_a8r8g8b8 : PICT_x8r8g8b8);
+    if (!f) return FALSE;
+    int error = 0;
+    PicturePtr src = CreatePicture(0, &old_pix->drawable,
+                                   f, 0, NULL, serverClient, &error);
+    PicturePtr dst = CreatePicture(0, &new_pix->drawable,
+                                   f, 0, NULL, serverClient, &error);
+    Bool copied = FALSE;
+    if (src && dst) {
+        PictTransform xf = {{{
+            pixman_double_to_fixed((double)old_pix->drawable.width /
+                                   new_pix->drawable.width), 0, 0
+        }, {
+            0, pixman_double_to_fixed((double)old_pix->drawable.height /
+                                      new_pix->drawable.height), 0
+        }, {
+            0, 0, pixman_fixed_1
+        }}};
+        if (SetPictureTransform(src, &xf) == Success &&
+            SetPictureFilter(src, "bilinear", 8, NULL, 0) == Success) {
+            ValidatePicture(src);
+            ValidatePicture(dst);
+            CompositePicture(PictOpSrc, src, NULL, dst,
+                             0, 0, 0, 0, 0, 0,
+                             new_pix->drawable.width, new_pix->drawable.height);
+            copied = TRUE;
+        }
+    }
+    if (dst) FreePicture(dst, 0);
+    if (src) FreePicture(src, 0);
+    return copied;
+}
