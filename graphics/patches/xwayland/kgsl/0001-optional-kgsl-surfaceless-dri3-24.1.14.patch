+static Bool
+init_buffer_params_kgsl_surfaceless(struct xwl_screen *xwl_screen,
+                                    PixmapPtr          pixmap,
+                                    uint32_t          *format,
+                                    uint64_t          *modifier,
+                                    int               *num_planes,
+                                    int               *prime_fds,
+                                    uint32_t          *strides,
+                                    uint32_t          *offsets)
+{
+    struct xwl_gbm_private *xwl_gbm = xwl_gbm_get(xwl_screen);
+    struct xwl_pixmap *xwl_pixmap = xwl_pixmap_get(pixmap);
+    EGLint image_attrs[] = {
+        EGL_GL_TEXTURE_LEVEL_KHR, 0,
+        EGL_IMAGE_PRESERVED_KHR, EGL_TRUE,
+        EGL_NONE
+    };
+    uint64_t modifiers[4] = {
+        DRM_FORMAT_MOD_INVALID,
+        DRM_FORMAT_MOD_INVALID,
+        DRM_FORMAT_MOD_INVALID,
+        DRM_FORMAT_MOD_INVALID
+    };
+    EGLint egl_strides[4];
+    EGLint egl_offsets[4];
+    int fourcc;
+    int i;
+
+    if (!xwl_pixmap || !xwl_pixmap->texture ||
+        !xwl_gbm->export_dmabuf_image_query ||
+        !xwl_gbm->export_dmabuf_image)
+        return FALSE;
+
+    xwl_glamor_egl_make_current(xwl_screen);
+
+    if (xwl_pixmap->image == EGL_NO_IMAGE_KHR) {
+        xwl_pixmap->image =
+            eglCreateImageKHR(xwl_screen->egl_display,
+                              xwl_screen->egl_context,
+                              EGL_GL_TEXTURE_2D_KHR,
+                              (EGLClientBuffer)(uintptr_t)xwl_pixmap->texture,
+                              image_attrs);
+        if (xwl_pixmap->image == EGL_NO_IMAGE_KHR) {
+            ErrorF("Xwayland glamor: failed to create KGSL EGLImage\n");
+            return FALSE;
+        }
+    }
+
+    glFinish();
+
+    if (!xwl_gbm->export_dmabuf_image_query(xwl_screen->egl_display,
+                                            xwl_pixmap->image,
+                                            &fourcc, num_planes,
+                                            modifiers)) {
+        ErrorF("Xwayland glamor: failed to query KGSL dma-buf export\n");
+        return FALSE;
