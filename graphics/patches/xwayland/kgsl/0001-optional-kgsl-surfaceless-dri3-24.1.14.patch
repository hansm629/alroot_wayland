+#ifdef DRI3
+static void
+xwl_glamor_kgsl_close_import_fds(struct xwl_pixmap *xwl_pixmap)
+{
+    int plane;
+
+    if (!xwl_pixmap->kgsl_dri3_import)
+        return;
+
+    for (plane = 0; plane < xwl_pixmap->kgsl_num_fds; plane++) {
+        if (xwl_pixmap->kgsl_fds[plane] >= 0) {
+            close(xwl_pixmap->kgsl_fds[plane]);
+            xwl_pixmap->kgsl_fds[plane] = -1;
+        }
+    }
+
+    xwl_pixmap->kgsl_dri3_import = FALSE;
+    xwl_pixmap->kgsl_num_fds = 0;
+}
+#endif /* DRI3 */
