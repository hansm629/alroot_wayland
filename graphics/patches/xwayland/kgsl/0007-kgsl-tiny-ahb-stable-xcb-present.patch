+static Bool
+s30_stable_enabled(void)
+{
+    const char *opt = getenv("S30_KGSL_STABLE_FRAME");
+    return opt && opt[0] == '1' && !opt[1];
+}
+
+static struct s30_stable_frame *
+s30_get_frame(WindowPtr window)
+{
+    return dixLookupPrivate(&window->devPrivates, &s30_stable_frame_key);
+}
+
+static void
+s30_drop_frame(WindowPtr window)
+{
+    struct s30_stable_frame *frame = s30_get_frame(window);
+    if (!frame)
+        return;
+    if (getenv("S30_TRACE_STABLE"))
+        ErrorF("S30_FRAME_DROP win=0x%lx snap=%p\n",
+               (unsigned long)window->drawable.id, (void *)frame->pixmap);
+    dixSetPrivate(&window->devPrivates, &s30_stable_frame_key, NULL);
+    if (frame->pixmap)
+        window->drawable.pScreen->DestroyPixmap(frame->pixmap);
+    free(frame);
+}
+
+/* No content from a resize placeholder is ever a source for the next
+ * placeholder. Invalidate only when a TRUE Vulkan DRI3 Present completes. */
+void
+xwl_window_s30_real_present(WindowPtr window)
+{
+    if (s30_stable_enabled())
+        s30_drop_frame(window);
+}
+
+static PixmapPtr
+s30_capture_stable_frame(WindowPtr window, DrawablePtr old_drawable)
+{
+    struct s30_stable_frame *frame;
+    ScreenPtr screen = window->drawable.pScreen;
+    unsigned width, height;
+    GCPtr gc;
+
+    if (!s30_stable_enabled() || !old_drawable)
+        return NULL;
+    frame = s30_get_frame(window);
+    if (frame && frame->pixmap) {
+        if (getenv("S30_TRACE_STABLE"))
+            ErrorF("S30_CAPTURE_REUSE win=0x%lx snap=%p\n",
+                   (unsigned long)window->drawable.id, (void *)frame->pixmap);
+        return frame->pixmap;
+    }
+
+    /* GetWindowPixmap(window) can be the whole 1920x1080 root backing
+     * pixmap in rootful Xwayland! Read the WINDOW drawable in its own
+     * local coordinates instead, otherwise a 200x140 client captures
+     * wallpaper pixels and the actual cube/gear is lost off-center. */
+    width = old_drawable->width;
+    height = old_drawable->height;
+    if (width < 30 || height < 30 || width > 1920 || height > 1080 ||
+        (old_drawable->depth != 24 && old_drawable->depth != 32))
+        return NULL;
+    if (getenv("S30_TRACE_STABLE"))
+        ErrorF("S30_CAPTURE_NEW win=0x%lx oldpix=0x%lx old=%ux%u imported=%d\n",
+               (unsigned long)window->drawable.id,
+               (unsigned long)old_drawable->id, width, height,
+               old_drawable->type == DRAWABLE_PIXMAP &&
+               xwl_glamor_kgsl_is_dri3_pixmap((PixmapPtr)old_drawable));
+
+    if (!frame) {
+        frame = calloc(1, sizeof(*frame));
+        if (!frame)
+            return NULL;
+        dixSetPrivate(&window->devPrivates, &s30_stable_frame_key, frame);
+    }
+    frame->pixmap = (*screen->CreatePixmap)(screen, width, height,
+                                            old_drawable->depth,
+                                            CREATE_PIXMAP_USAGE_SCRATCH);
+    if (!frame->pixmap)
+        return NULL;
+
+    gc = GetScratchGC(frame->pixmap->drawable.depth, screen);
+    if (!gc) {
+        screen->DestroyPixmap(frame->pixmap);
+        frame->pixmap = NULL;
+        return NULL;
+    }
+    ValidateGC(&frame->pixmap->drawable, gc);
+    (void)(*gc->ops->CopyArea)(old_drawable,
+                              &frame->pixmap->drawable, gc,
+                              0, 0, width, height, 0, 0);
+    FreeScratchGC(gc);
+    if (getenv("S30_TRACE_STABLE"))
+        ErrorF("S30_CAPTURE_DONE win=0x%lx snap=%p\n",
+               (unsigned long)window->drawable.id, (void *)frame->pixmap);
+    return frame->pixmap;
+}
