--- a/hw/xwayland/xwayland-screen.c
+++ b/hw/xwayland/xwayland-screen.c
@@ -455,9 +455,22 @@
         if (xwl_window->frame_callback) {
 #ifdef XWL_HAS_GLAMOR
             if (kgsl) {
-                xwl_window->blocked_frame_callback_count++;
-                if (xwl_window->blocked_frame_callback_count < 64)
-                    continue;
+                const char *s38 = getenv("S38_KGSL_FRAME_LIFETIME");
+                if (s38 && s38[0] == '1' && !s38[1]) {
