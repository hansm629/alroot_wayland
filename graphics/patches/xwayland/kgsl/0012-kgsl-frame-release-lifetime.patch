+                    if (elapsed < 100)
+                        continue;
+                    ErrorF("S38_FRAME_WATCHDOG_RECOVERY elapsed_ms=%u\n", elapsed);
+                } else {
+                    xwl_window->blocked_frame_callback_count++;
+                    if (xwl_window->blocked_frame_callback_count < 64)
+                        continue;
+                }
                 xwl_window->blocked_frame_callback_count = 0;
