+    xwl_screen = xwl_screen_get(screen);
+    if (!s28_is_optin_xcb_gpu_window(window, xwl_screen))
+        return;
+    w = window->drawable.width;
+    h = window->drawable.height;
+    sw = source->drawable.width;
+    sh = source->drawable.height;
+    /* Present can copy a 350x252 old swapchain while XFWM4's window is
+     * already 900x720. Conversely it can paste a huge old GLX texture
+     * into a tiny new window, clipping the blue/red gear at the top.
+     * Those images are not valid at the new viewport geometry. */
+    stale_extent = abs(sw - w) > (w / 10 > 12 ? w / 10 : 12) ||
+                   abs(sh - h) > (h / 10 > 12 ? h / 10 : 12);
+    if (w < 1 || h < 1 || w > 4096 || h > 4096 ||
+        sw < 1 || sh < 1 || (!stale_extent && sw >= w && sh >= h) ||
+        source->drawable.depth != window->drawable.depth ||
+        (window->drawable.depth != 24 && window->drawable.depth != 32))
+        return;
