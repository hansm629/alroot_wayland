#!/data/data/com.termux/files/usr/bin/bash
# Alroot Wayland P01 convenience launcher (tx11start-inspired, never calls it).
set -euo pipefail

HOME=/data/data/com.termux/files/home
PREFIX=/data/data/com.termux/files/usr
PROJECT="$HOME/alroot_wayland"
STATE="$HOME/.alroot-wayland"
CONTROL="$STATE/control"
CLI="$PROJECT/termux/alroot-wayland"
APP="com.alroot.wayland/.MainActivity"
export TMPDIR="$PREFIX/tmp"

usage() {
    cat <<'HELP'
awstart                           Start helper + XFCE4 (nested Labwc, software client)
awstart --direct                  Diagnostic: host -> rootful Xwayland -> XFCE4
awstart --profile xfce-labwc      Explicit normal profile (default)
awstart --profile xfce-shm-direct
awstart --topapp                  Spawn from foreground helper Activity (default)
awstart --no-topapp               Spawn from Termux shell (CPU policy may differ)
awstart --no-wait                 Queue request without waiting for session startup
awstart --status                  Show installed APK and this project's session
awstart --open                    Reopen helper Activity, do not start a session
awstart --stop                    Stop only project-owned desktop processes
awstart --restart                 Stop project session and start again
awstart --logs                    Show project-specific logs
awstart --doctor                  Check APK, CLI, Labwc and Termux dependencies
awstart --smoke                   Run safe local preflight checks
awstart --refresh-diag            Check actual Xwayland mode and Android VSync logs
awstart --ime-fcitx               Prefer native Fcitx5 Hangul preedit on next start
awstart --ime-xtest               Restore legacy XTEST input on next start
awstart --install-apk             Open Android installer for signed P01 APK
awstart --debug                   Show more launch and status information
awstart --dry-run                 Preview without opening apps or changing files
awstart --help                    Display this help

P01 rendering: nested Labwc uses pixman/SHM; Android host still uses Vulkan.
No Termux-X11 pkill, no global Mesa change, no GPU keep-alive/clock overrides.
HELP
}

die() { printf '[awstart] ERROR: %s\n' "$*" >&2; exit 1; }
msg() { printf '[awstart] %s\n' "$*"; }
local_apk="$PROJECT/artifacts/alroot-wayland-p01-signed.apk"
installed_apk_path() {
    local found attempt
    for attempt in 1 2 3; do
        found="$(pm path com.alroot.wayland 2>/dev/null | sed -n '1s/^package://p')"
        if [[ -n "$found" ]]; then
            printf '%s\n' "$found"
            return 0
        fi
        ((attempt < 3)) && sleep .3
    done
    return 1
}
app_installed() {
    local installed packages
    installed="$(installed_apk_path)" || true
    if [[ -n "$installed" && -r "$installed" ]]; then
        return 0
    fi
    # pm path may temporarily return no path during a package install/update.
    # A second PackageManager view is useful, but absence in both is still
    # UNKNOWN rather than definitive proof that the APK was uninstalled.
    packages="$(cmd package list packages --user 0 2>/dev/null)" || return 1
    grep -Fxq 'package:com.alroot.wayland' <<< "$packages"
}
app_matches_local_apk() {
    local installed
    [[ -r "$local_apk" ]] || return 1
    installed="$(installed_apk_path)"
    [[ -n "$installed" && -r "$installed" ]] || return 1
    cmp -s "$installed" "$local_apk"
}
app_status() {
    if app_matches_local_apk; then
        msg 'Android helper APK: INSTALLED (matches latest locally signed APK)'
    elif app_installed; then
        msg 'Android helper APK: INSTALLED (local signed APK version not verified)'
    else
        msg 'Android helper APK: UNCONFIRMED (PackageManager has no current record)'
    fi
}
open_helper_activity() {
    local response rc=0
    response="$(am start -n "$APP" 2>&1)" || rc=$?
    if ((rc != 0)) ||
        grep -Eiq 'Error type [0-9]+|Activity class .* does not exist|Exception occurred' <<< "$response"; then
        die "Android ActivityManager could not open $APP: $response"
    fi
    ((debug)) && printf '%s\n' "$response"
    return 0
}

action=start
profile=xfce-labwc
topapp=1
no_wait=0
debug=0
dry_run=0
primary_action_count=0
while (($#)); do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --start) ((primary_action_count+=1)); action=start ;;
        --direct|--shm-direct) profile=xfce-shm-direct ;;
        --profile)
            (($# >= 2)) || die '--profile requires a name'
            profile="$2"; shift ;;
        --topapp) topapp=1 ;;
        --no-topapp) topapp=0 ;;
        --no-wait) no_wait=1 ;;
        --debug) debug=1 ;;
        --dry-run) dry_run=1 ;;
        --open|--stop|--status|--logs|--doctor|--smoke|--refresh-diag|--install-apk|--restart|--ime-fcitx|--ime-xtest)
            ((primary_action_count+=1))
            action="${1#--}" ;;
        --nogpu|--no-gpu)
            die 'P01 guest uses pixman already; --nogpu would incorrectly imply Android Vulkan is disabled.' ;;
        --xstartup|--nodbus|--legacy)
            die "$1 is not a supported P01 mode (only XFCE4 is validated)." ;;
        *) die "Unknown option $1 (awstart --help)" ;;
    esac
    shift
done
((primary_action_count <= 1)) || die 'Specify only one primary action'
[[ "$profile" == xfce-labwc || "$profile" == xfce-shm-direct ]] ||
    die "Invalid profile: $profile"
[[ -r "$CLI" ]] || die "Missing Alroot session CLI: $CLI"

case "$action" in
    ime-fcitx|ime-xtest)
        preferred="${action#ime-}"
        ((dry_run)) && { msg "Would use $preferred IME on the next project session start"; exit 0; }
        mkdir -p "$STATE"
        chmod 700 "$STATE"
        printf '%s\n' "$preferred" > "$STATE/ime-backend"
        chmod 600 "$STATE/ime-backend"
        msg "Alroot IME preference: $preferred (takes effect after awstart --restart)"
        msg 'Original Termux-X11 :0 and installed APK were not changed.'
        exit 0 ;;
    status)
        app_status
        exec "$PREFIX/bin/bash" "$CLI" status ;;
    logs)
        "$CLI" logs
        ((debug)) && { logcat -d -s AlrootWayland AlrootWayland 2>/dev/null | tail -25 || true; }
        exit 0 ;;
    doctor)
        "$CLI" doctor
        app_status
        msg 'Client renderer: pixman; native Android host: Vulkan (not disabled)'
        exit 0 ;;
    smoke) exec "$PREFIX/bin/bash" "$PROJECT/tests/p01-smoke.sh" ;;
    refresh-diag) exec "$PREFIX/bin/bash" "$PROJECT/tests/p03-fundamentals.sh" ;;
    stop)
        # Never terminate the very XFCE session executing this command.
        # Inside that desktop the user must use a separate native Termux
        # shell, just as for --restart. Otherwise the session group may
        # signal its own stop command and leave an orphaned Xwayland PID.
        if (( !dry_run )) && [[ "${XDG_CONFIG_HOME:-}" == "$STATE/xfce-config" ]] &&
           [[ -n "${DISPLAY:-}" && -r "$STATE/display" ]] &&
           [[ "${DISPLAY%%.*}" == "$(cat "$STATE/display")" ]]; then
            die 'Cannot stop from inside the running Alroot XFCE terminal. Use a separate native Termux shell.'
        fi
        "$CLI" stop
        msg 'Project session stop requested; native Android host remains until explicitly stopped.'
        exit 0 ;;
    install-apk)
        [[ -r "$local_apk" ]] || die "Missing signed APK: $local_apk"
        if app_matches_local_apk; then
            msg 'APK already installed: byte-for-byte identical to the latest locally signed build.'
            msg 'No update needed. Run awstart.'
            exit 0
        fi
        ((dry_run)) && { msg "Would open Android package installer for $local_apk"; exit 0; }
        termux-open --view --content-type application/vnd.android.package-archive "$local_apk"
        msg 'Android installer has been requested, NOT yet confirmed installed.'
        msg 'Approve Install/Update on the device, then run: awstart --status'
        msg 'Begin awstart when status reports INSTALLED (matches latest locally signed APK).'
        exit 0 ;;
    open)
        ((dry_run)) && { msg "Would execute: am start -n $APP"; exit 0; }
        # ActivityManager is the final authority for opening an Activity.
        # Do not reject a valid installed APK merely because pm path briefly
        # returned nothing during PackageManager installation transitions.
        open_helper_activity
        msg 'Helper Activity open requested; this does not prove XFCE pixels.'
        exit 0 ;;
    restart)
        # A restart launched *inside its own XFCE4 terminal* would signal
        # the caller's session group during --stop and never reach --start.
        # Guard only this project's XFCE profile, not independent Termux
        # shells which may legitimately have a DISPLAY set for diagnostics.
        if (( !dry_run )) && [[ "${XDG_CONFIG_HOME:-}" == "$STATE/xfce-config" ]] &&
           [[ -n "${DISPLAY:-}" ]] && [[ -r "$STATE/display" ]] &&
           [[ "${DISPLAY%%.*}" == "$(cat "$STATE/display")" ]];then
            die 'Cannot restart from inside the Alroot XFCE session being stopped. Run awstart --restart from a separate native Termux shell.'
        fi
        ((dry_run)) || "$CLI" stop ;;
    start) ;;
esac

if ((dry_run)); then
    msg "profile=$profile, spawn=$([[ "$topapp" == 1 ]] && echo 'helper-Activity' || echo 'Termux-shell'), no-wait=$no_wait"
    msg 'Would open Alroot Wayland APK and start only the selected XFCE4 profile.'
    exit 0
fi

[[ "$(id -u)" != 0 ]] || die 'Run as Termux native user, not root'
tracer="$(sed -n 's/^TracerPid:[[:space:]]*//p' "/proc/$$/status" | head -1)"
if [[ "${tracer:-0}" != 0 ]]; then
    tracer_name="$(sed -n 's/^Name:[[:space:]]*//p' "/proc/$tracer/status" 2>/dev/null | head -1)"
    [[ "${tracer_name:-}" != proot ]] ||
        die 'Run outside PRoot in the native Termux shell'
fi
if ! app_installed; then
    msg 'PackageManager lookup inconclusive; attempting the fixed helper Activity directly.'
fi

# Safe, idempotent default: reopening an existing profile does not spawn
# a second XFCE or disturb existing Termux-X11. --restart is explicit.
current_status="$("$CLI" status)"
if grep -q '^xfce: RUNNING ' <<< "$current_status"; then
    active_profile="$(sed -n 's/^profile: //p' <<< "$current_status" | head -1)"
    if [[ "$active_profile" == "$profile" ]] &&
       grep -q '^xwayland: RUNNING ' <<< "$current_status" &&
       { [[ "$profile" == xfce-shm-direct ]] ||
         grep -q '^labwc: RUNNING ' <<< "$current_status"; }; then
        open_helper_activity
        msg "Already running: $profile. Reopened helper without starting another session."
        printf '%s\n' "$current_status"
        exit 0
    fi
    die "Another Alroot session is active: $active_profile. Use awstart --stop or --restart."
fi

if ((topapp)); then
    # REQUESTED means the Android Activity called ProcessBuilder.start(),
    # NOT that the new Termux bash process actually entered start_session().
    # Count private START_BEGIN entries so a failed Java child spawn is
    # diagnosed separately from a native Xwayland/XFCE failure.
    start_count_before="$(grep -c ' action=START_BEGIN ' "$STATE/logs/session-control.log" 2>/dev/null || true)"
    start_count_before="${start_count_before:-0}"
    umask 077
    mkdir -p "$CONTROL"
    chmod 700 "$STATE" "$CONTROL"
    exec 8>"$CONTROL/request.lock"
    flock -n 8 || die 'Another awstart request is active'
    [[ ! -L "$CONTROL/start-request" ]] || die 'Untrusted request symlink'
    stamp="$(date +%s)"
    request_id="$stamp-$$"
    candidate="$(mktemp "$CONTROL/.request.XXXXXXXX")"
    printf 'start %s %s %s\n' "$profile" "$stamp" "$request_id" > "$candidate"
    chmod 600 "$candidate"
    mv -f "$candidate" "$CONTROL/start-request"
    rm -f "$CONTROL/start-ack"
    if ! am start -n "$APP" > "$CONTROL/open.log" 2>&1 ||
        grep -Eiq 'Error type [0-9]+|Activity class .* does not exist|Exception occurred' "$CONTROL/open.log"; then
        if [[ -f "$CONTROL/start-request" ]] &&
            grep -qF " $request_id" "$CONTROL/start-request"; then
            rm -f "$CONTROL/start-request"
        fi
        die "Cannot open helper Activity. See $CONTROL/open.log"
    fi
    msg "Foreground helper requested: $profile"
    ((debug)) && { cat "$CONTROL/open.log"; msg "Request ID: $request_id"; }
    ((no_wait)) && { msg 'Queued; check awstart --status / --logs.'; exit 0; }
    accepted=0
    for ((attempt=0; attempt<30; ++attempt)); do
        if [[ -f "$CONTROL/start-ack" ]]; then
            IFS=' ' read -r ack_id ack_state < "$CONTROL/start-ack" || true
            if [[ "${ack_id:-}" == "$request_id" ]]; then
                if [[ "${ack_state:-}" == REQUESTED ]]; then accepted=1; break; fi
                die "Helper rejected request: $ack_state (awstart --logs)"
            fi
        fi
        sleep .5
    done
    ((accepted)) || die 'Foreground helper did not acknowledge. Check app screen and Android logs.'
    msg 'Foreground Activity accepted session spawn request (NOT yet graphical PASS).'
else
    msg 'Shell-spawn mode does NOT ensure top-app CPU scheduling.'
    open_helper_activity
    "$CLI" start --profile "$profile"
    ((no_wait)) && exit 0
fi

for ((attempt=0; attempt<40; ++attempt)); do
    report="$("$CLI" status)"
    if grep -q '^host: .* READY$' <<< "$report" &&
       grep -q '^xwayland: RUNNING ' <<< "$report" &&
       grep -q '^xfce: RUNNING ' <<< "$report" &&
       grep -q '^x11_desktop: READY ' <<< "$report" &&
       { [[ "$profile" == xfce-shm-direct ]] ||
         grep -q '^labwc: RUNNING ' <<< "$report"; }; then
        msg 'X11 WM, xfdesktop and panel registered on isolated Xwayland. Android image needs visual verification.'
        printf '%s\n' "$report"
        exit 0
    fi
    sleep .5
done
msg 'Desktop did not reach process readiness; latest status:'
"$CLI" status
if ((topapp));then
    start_count_after="$(grep -c ' action=START_BEGIN ' "$STATE/logs/session-control.log" 2>/dev/null || true)"
    start_count_after="${start_count_after:-0}"
    if (( start_count_after <= start_count_before ));then
        msg 'Foreground Activity acknowledged ProcessBuilder.start, but the Termux session CLI did not begin. This is a helper child-execution failure, not an Xwayland/GLX crash.'
        msg 'A caller may retry with the explicit S25 shell-recovery route; no system GPU driver will be changed.'
    fi
fi
msg 'Collect logs: awstart --logs'
exit 1
