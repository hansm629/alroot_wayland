#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

HOME=/data/data/com.termux/files/home
PREFIX=/data/data/com.termux/files/usr
STATE="$HOME/.alroot-wayland"
RUNTIME="$STATE/runtime"
LOGS="$STATE/logs"
export TMPDIR="$PREFIX/tmp"
mkdir -p "$STATE" "$LOGS"
chmod 700 "$STATE" "$LOGS"

usage() {
    echo 'usage: alroot-wayland start --profile xfce-labwc|xfce-shm-direct'
    echo '       alroot-wayland status|open|stop|doctor|logs'
}

process_start_ticks() {
    local pid="$1" line
    [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/stat" ]] || return 1
    IFS= read -r line < "/proc/$pid/stat" || return 1
    line="${line##*) }"
    local -a fields
    read -r -a fields <<< "$line"
    [[ "${fields[19]:-}" =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "${fields[19]}"
}

isolated_session_leader() {
    local pid="$1" line
    [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/stat" ]] || return 1
    IFS= read -r line < "/proc/$pid/stat" || return 1
    line="${line##*) }"
    local -a fields
    read -r -a fields <<< "$line"
    [[ "${fields[2]:-}" == "$pid" && "${fields[3]:-}" == "$pid" ]]
}

owned_pid_active() {
    local role="$1" pid="" expected="" marker="" current=""
    [[ -f "$STATE/$role.pid" ]] || return 1
    read -r pid expected marker < "$STATE/$role.pid" || return 1
    [[ "$marker" == "alroot-wayland" ]] || return 1
    current="$(process_start_ticks "$pid")" || return 1
    [[ "$current" == "$expected" ]] || return 1
}

alive() {
    local role="$1" pid="" expected="" marker=""
    owned_pid_active "$role" || return 1
    read -r pid expected marker < "$STATE/$role.pid" || return 1
    local cmd
    cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
    case "$role" in
        labwc) [[ "$cmd" == *"/labwc"* || "$cmd" == "labwc "* ]] ;;
        xwayland) [[ "$cmd" == *"/Xwayland"* || "$cmd" == "Xwayland "* ]] ;;
        xfce) [[ "$cmd" == *"dbus-run-session"* || "$cmd" == *"/xfce4-session"* ]] ;;
        clipboard) [[ "$cmd" == *"/clipboard-broker.sh"* ]] ;;
        *) return 1 ;;
    esac
}

record_pid() {
    local name="$1" pid="$2"
    local start
    start="$(process_start_ticks "$pid")" || {
        echo "Cannot inspect started $name PID $pid" >&2
        return 1
    }
    printf '%s %s alroot-wayland\n' "$pid" "$start" > "$STATE/$name.pid"
}

socket_ready() {
    [[ -S "$1" ]] || return 1
    python3 -c 'import socket,sys
s=socket.socket(socket.AF_UNIX)
s.settimeout(.3)
try: s.connect(sys.argv[1])
except OSError: sys.exit(1)
finally: s.close()' "$1" >/dev/null 2>&1
}

wait_socket() {
    local name="$1" i
    for ((i=0; i<90; ++i)); do
        if socket_ready "$RUNTIME/$name"; then return 0; fi
        sleep .2
    done
    return 1
}

wait_nested_socket() {
    local i path parent
    for ((i=0; i<90; ++i)); do
        for path in "$RUNTIME"/wayland-*; do
            [[ -S "$path" && "$path" != "$RUNTIME/wayland-0" ]] || continue
            if socket_ready "$path"; then
                parent="${path##*/}"
                printf '%s\n' "$parent" > "$STATE/labwc-socket"
                printf '%s\n' "$parent"
                return 0
            fi
        done
        owned_pid_active labwc || return 1
        sleep .2
    done
    return 1
}

# A running XFCE PID is insufficient. On Xfce 4.20 some components may choose
# Wayland instead of the rootful X11 session, leaving the Android view black.
# Prove the actual X11 WM, xfdesktop and panel on the *isolated* DISPLAY.
x11_desktop_ready() {
    local display="" list="" id="" props="" wm="" desktop=0 panel=0
    [[ -r "$STATE/display" && -r "$STATE/Xauthority" ]] || return 1
    IFS= read -r display < "$STATE/display"
    [[ "$display" =~ ^:[0-9]{1,3}$ && "$display" != :0 ]] || return 1
    alive xwayland && alive xfce || return 1
    wm="$(env -u WAYLAND_DISPLAY DISPLAY="$display" XAUTHORITY="$STATE/Xauthority" \
            timeout 2 xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null)" || return 1
    [[ "$wm" == *"window id #"* ]] || return 1
    list="$(env -u WAYLAND_DISPLAY DISPLAY="$display" XAUTHORITY="$STATE/Xauthority" \
            timeout 2 xprop -root _NET_CLIENT_LIST 2>/dev/null)" || return 1
    list="${list#*# }"
    for id in ${list//,/ }; do
        [[ "$id" =~ ^0x[0-9a-fA-F]+$ ]] || continue
        props="$(env -u WAYLAND_DISPLAY DISPLAY="$display" XAUTHORITY="$STATE/Xauthority" \
                timeout 2 xprop -id "$id" WM_CLASS 2>/dev/null)" || continue
        [[ "$props" == *'"Xfdesktop"'* ]] && desktop=1
        [[ "$props" == *'"Xfce4-panel"'* ]] && panel=1
    done
    ((desktop && panel))
}

xfce_start() {
    local display="$1"
    mkdir -p "$STATE/xfce-config" "$STATE/xfce-cache"
    # One-time profile snapshot: never write into the original settings.
    local config_name
    for config_name in xfce4 nimf fontconfig gtk-3.0 gtk-4.0 qt5ct qt6ct; do
        if [[ -e "$HOME/.config/$config_name" && ! -e "$STATE/xfce-config/$config_name" ]]; then
            cp -a "$HOME/.config/$config_name" "$STATE/xfce-config/"
        fi
    done
    # Project-only XFCE panel integration: Termux:API battery + Plank launcher.
    "$PREFIX/bin/python3" "$HOME/alroot_wayland/termux/configure-xfce-profile.py" \
        > "$LOGS/profile.log" 2>&1
    (
        export HOME PREFIX PATH="$PREFIX/bin:$PREFIX/bin/applets"
        export DISPLAY="$display" XAUTHORITY="$STATE/Xauthority"
        export XDG_RUNTIME_DIR="$RUNTIME" XDG_CONFIG_HOME="$STATE/xfce-config"
        export XDG_CACHE_HOME="$STATE/xfce-cache" XDG_SESSION_TYPE=x11
        # Xfce 4.20/GTK4 can otherwise auto-select the available Wayland
        # socket in this isolated runtime despite DISPLAY pointing at Xwayland.
        # This is the *rootful X11 desktop*, NOT Labwc or the Android host.
        export GDK_BACKEND=x11 QT_QPA_PLATFORM=xcb SDL_VIDEODRIVER=x11
        export DESKTOP_SESSION=xfce XDG_CURRENT_DESKTOP=XFCE
        unset WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS SESSION_MANAGER
        export NO_AT_BRIDGE=1
        # Separate process group so explicit stop can target this session's
        # descendants without signalling any pre-existing desktop session.
        exec setsid dbus-run-session -- xfce4-session
    ) > "$LOGS/xfce.log" 2>&1 &
    record_pid xfce "$!"
}

clipboard_start() {
    if ! command -v xclip >/dev/null 2>&1 || ! command -v xdotool >/dev/null 2>&1; then
        echo 'BLOCKED: xclip and xdotool are required for X11 text input' >&2
        return 1
    fi
    (
        export HOME PREFIX PATH="$PREFIX/bin:$PREFIX/bin/applets"
        export XDG_RUNTIME_DIR="$RUNTIME"
        exec "$PREFIX/bin/bash" "$HOME/alroot_wayland/termux/clipboard-broker.sh" "$STATE" "$1"
    ) > "$LOGS/clipboard.log" 2>&1 &
    record_pid clipboard "$!"
}

start_xwayland() {
    local parent_display="$1" n
    export XDG_RUNTIME_DIR="$RUNTIME" WAYLAND_DISPLAY="$parent_display"
    export XAUTHORITY="$STATE/Xauthority"
    # Never inherit a pre-existing Termux-X11 :0 DISPLAY from the caller.
    unset DISPLAY
    for n in $(seq 90 180); do
        if [[ ! -e "$PREFIX/tmp/.X11-unix/X$n" && ! -e "$PREFIX/tmp/.X$n-lock" ]]; then
            break
        fi
    done
    [[ "$n" -le 180 ]] || { echo 'no unoccupied X DISPLAY' >&2; return 1; }
    : > "$XAUTHORITY"
    chmod 600 "$XAUTHORITY"
    local cookie
    cookie="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
    xauth -f "$XAUTHORITY" add ":$n" MIT-MAGIC-COOKIE-1 "$cookie" >/dev/null 2>&1
    unset cookie
    # Do not use -terminate: the xdpyinfo readiness probe is a short-lived
    # X11 client. With -terminate, the server exits before XFCE connects.
    # Native host and rootful Xwayland must use the SAME guest resolution.
    # Otherwise a 1280x720 desktop occupies only part of a 1920x1080 scene.
    local guest_w=1920 guest_h=1080 candidate_w="" candidate_h=""
    if [[ -r "$STATE/output-resolution" ]]; then
        read -r candidate_w candidate_h < "$STATE/output-resolution" || true
        if [[ "$candidate_w" =~ ^[0-9]{3,4}$ && "$candidate_h" =~ ^[0-9]{3,4}$ ]] &&
            ((candidate_w >= 320 && candidate_w <= 3840 &&
              candidate_h >= 240 && candidate_h <= 2160)); then
            guest_w="$candidate_w"; guest_h="$candidate_h"
        fi
    fi
    printf '%s %s\n' "$guest_w" "$guest_h" > "$STATE/x11-geometry"
    Xwayland ":$n" -geometry "${guest_w}x${guest_h}" -dpi 96 \
        -auth "$XAUTHORITY" -nolisten tcp \
        > "$LOGS/xwayland.log" 2>&1 &
    record_pid xwayland "$!"
    local i
    for ((i=0; i<90; ++i)); do
        if DISPLAY=":$n" xdpyinfo -display ":$n" >/dev/null 2>&1; then
            printf ':%d\n' "$n" > "$STATE/display"
            # The Android app cannot reliably inspect another process's
            # /proc PID start time under Android SELinux. Publish an owned,
            # session-scoped marker only after the X socket really responds.
            printf ':%d\n' "$n" > "$STATE/ime-active"
            chmod 600 "$STATE/ime-active"
            echo "Xwayland :$n ready at ${guest_w}x${guest_h} 96DPI"
            return 0
        fi
        if ! owned_pid_active xwayland; then
            tail -15 "$LOGS/xwayland.log" >&2
            return 1
        fi
        sleep .2
    done
    echo 'Xwayland did not accept authenticated X11 connection' >&2
    return 1
}

start_session() {
    local profile="$1"
    [[ "$profile" == xfce-labwc || "$profile" == xfce-shm-direct ]] || {
        echo "Unsupported profile: $profile" >&2; return 2;
    }
    exec 8>"$STATE/start.lock"
    flock -n 8 || { echo 'another Alroot startup is active' >&2; return 1; }
    if alive xwayland || alive xfce || alive labwc || alive clipboard; then
        echo 'Existing Alroot session found; run status or stop first' >&2; return 1
    fi
    # Refuse to attach to an unexpected nested socket from a previous session.
    local path
    for path in "$RUNTIME"/wayland-*; do
        [[ -S "$path" && "$path" != "$RUNTIME/wayland-0" ]] || continue
        if socket_ready "$path"; then
            echo "BLOCKED: unexpected nested Wayland socket already in use: $path" >&2
            return 1
        fi
    done
    # Failed intermediate stages must not leave project-owned processes alive.
    rm -f "$STATE/ime-active"
    trap 'rc=$?; if ((rc != 0)); then stop_one clipboard; stop_one xfce; stop_one xwayland; stop_one labwc; fi' EXIT
    if ! wait_socket wayland-0; then
        echo "BLOCKED: Android helper socket $RUNTIME/wayland-0 is not accepting connections" >&2
        return 1
    fi
    mkdir -p "$STATE/ipc"
    chmod 700 "$STATE/ipc"
    # A newly started project session cannot inherit an obsolete X11 selection.
    rm -f "$STATE/ipc/x11-to-android.txt" "$STATE/ipc/.last-injected.txt"
    if [[ -d "$STATE/ipc/ime-requests" ]]; then
        find "$STATE/ipc/ime-requests" -maxdepth 1 -type f -name '*.commit' -delete
        find "$STATE/ipc/ime-requests" -maxdepth 1 -type f -name '*.delete' -delete
    fi
    echo "$profile" > "$STATE/profile"
    local parent=wayland-0
    if [[ "$profile" == xfce-labwc ]]; then
        command -v labwc >/dev/null || { echo 'BLOCKED: no Termux labwc' >&2; return 1; }
        mkdir -p "$STATE/labwc-config"
        (
            export HOME PREFIX PATH="$PREFIX/bin:$PREFIX/bin/applets"
            export XDG_RUNTIME_DIR="$RUNTIME" WAYLAND_DISPLAY=wayland-0
            export WLR_BACKENDS=wayland WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1
            export XDG_CONFIG_HOME="$STATE/xfce-config"
            if [[ -r "$HOME/alroot_wayland/packages/prefix/lib/libwlroots-0.18.so" ]]; then
                export LD_LIBRARY_PATH="$HOME/alroot_wayland/packages/prefix/lib"
            fi
            unset DISPLAY DBUS_SESSION_BUS_ADDRESS
            exec labwc -C "$STATE/labwc-config"
        ) > "$LOGS/labwc.log" 2>&1 &
        record_pid labwc "$!"
        if ! parent="$(wait_nested_socket)"; then
            echo 'BLOCKED: Labwc Wayland backend did not start (nested socket missing)' >&2
            tail -16 "$LOGS/labwc.log" >&2
            return 1
        fi
    fi
    start_xwayland "$parent"
    xfce_start "$(cat "$STATE/display")"
    clipboard_start "$(cat "$STATE/display")"
    sleep .6
    if ! alive xfce; then
        echo 'FAIL: XFCE exited immediately' >&2
        tail -16 "$LOGS/xfce.log" >&2
        return 1
    fi
    echo "Alroot $profile started on $(cat "$STATE/display")"
    trap - EXIT
}

stop_one() {
    local role="$1" pid=""
    if owned_pid_active "$role"; then
        read -r pid _ < "$STATE/$role.pid"
        if [[ "$role" == xfce ]] && isolated_session_leader "$pid"; then
            kill -TERM -- "-$pid" 2>/dev/null || true
        else
            kill -TERM "$pid" 2>/dev/null || true
        fi
        echo "signalled Alroot $role pid $pid"
    fi
    rm -f "$STATE/$role.pid"
}

case "${1:-}" in
    start)
        [[ "${2:-}" == --profile && -n "${3:-}" ]] || { usage; exit 2; }
        start_session "$3"
        ;;
    status)
        echo "host: $RUNTIME/wayland-0 $(socket_ready "$RUNTIME/wayland-0" && echo READY || echo DOWN)"
        for role in labwc xwayland xfce clipboard; do
            if alive "$role"; then echo "$role: RUNNING $(cut -d' ' -f1 "$STATE/$role.pid")"
            else echo "$role: DOWN"; fi
        done
        if x11_desktop_ready; then
            echo 'x11_desktop: READY (xfwm4 + xfdesktop + xfce4-panel on isolated Xwayland)'
        else
            echo 'x11_desktop: INCOMPLETE (X11 window-manager/desktop/panel not verified)'
        fi
        [[ ! -f "$STATE/profile" ]] || echo "profile: $(cat "$STATE/profile")"
        [[ ! -f "$STATE/display" ]] || echo "X DISPLAY: $(cat "$STATE/display")"
        ;;
    stop)
        rm -f "$STATE/ime-active"
        stop_one clipboard
        stop_one xfce
        stop_one xwayland
        stop_one labwc
        rm -f "$STATE/display"
        rm -f "$STATE/labwc-socket"
        ;;
    open)
        am start -n com.alroot.wayland/.MainActivity
        ;;
    logs)
        for f in "$LOGS"/{labwc,xwayland,xfce,clipboard}.log "$STATE/spawn.log"; do
            if [[ -r "$f" ]]; then echo "--- $f"; tail -24 "$f"; fi
        done
        ;;
    doctor)
        echo "Termux uid: $(id -u)"
        for tool in labwc Xwayland xfce4-session dbus-run-session xauth python3; do
            if command -v "$tool" >/dev/null 2>&1; then echo "$tool: $(command -v "$tool")"
            else echo "$tool: MISSING"; fi
        done
        if command -v labwc >/dev/null 2>&1; then
            if [[ -r "$HOME/alroot_wayland/packages/prefix/lib/libwlroots-0.18.so" ]]; then
                LD_LIBRARY_PATH="$HOME/alroot_wayland/packages/prefix/lib" labwc -h 2>&1 | head -4 || true
            else
                labwc -h 2>&1 | head -4 || true
            fi
        fi
        if [[ -d "$RUNTIME" ]]; then stat -c 'runtime permissions: %a' "$RUNTIME"; fi
        ;;
    *)
        usage; exit 2 ;;
esac
