#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

HOME=/data/data/com.termux/files/home
PREFIX=/data/data/com.termux/files/usr
STATE="$HOME/.alroot-wayland"
RUNTIME="$STATE/runtime"
LOGS="$STATE/logs"
export TMPDIR="$PREFIX/tmp"
mkdir -p "$STATE" "$LOGS"
chmod 700 "$STATE" "$LOGS"

# Non-sensitive action diagnostics: when a session is terminated unexpectedly
# we need to distinguish an explicit stop request from a client/server crash.
# Do not store arguments, environment values, user commands or credentials.
control_event() {
    local action="$1" source="unknown" pgid="unknown" sid="unknown"
    source="$(ps -o comm= -p "$PPID" 2>/dev/null | tr -d '\n' | cut -c1-48)"
    read -r pgid sid < <(ps -o pgid=,sid= -p $$ 2>/dev/null) || true
    printf '%s action=%s pid=%s parent_pid=%s parent_name=%s pgid=%s sid=%s\n' \
        "$(date -Is)" "$action" "$$" "$PPID" "$source" "$pgid" "$sid" \
        >> "$LOGS/session-control.log"
}

usage() {
    echo 'usage: alroot-wayland start --profile xfce-labwc|xfce-shm-direct'
    echo '       alroot-wayland status|open|stop|doctor|logs'
}

process_start_ticks() {
    local pid="$1" line
    [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/stat" ]] || return 1
    IFS= read -r line < "/proc/$pid/stat" || return 1
    line="${line##*) }"
    local -a fields
    read -r -a fields <<< "$line"
    [[ "${fields[19]:-}" =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "${fields[19]}"
}

isolated_session_leader() {
    local pid="$1" line
    [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/stat" ]] || return 1
    IFS= read -r line < "/proc/$pid/stat" || return 1
    line="${line##*) }"
    local -a fields
    read -r -a fields <<< "$line"
    [[ "${fields[2]:-}" == "$pid" && "${fields[3]:-}" == "$pid" ]]
}

owned_pid_active() {
    local role="$1" pid="" expected="" marker="" current=""
    [[ -f "$STATE/$role.pid" ]] || return 1
    read -r pid expected marker < "$STATE/$role.pid" || return 1
    [[ "$marker" == "alroot-wayland" ]] || return 1
    current="$(process_start_ticks "$pid")" || return 1
    [[ "$current" == "$expected" ]] || return 1
}

alive() {
    local role="$1" pid="" expected="" marker=""
    owned_pid_active "$role" || return 1
    read -r pid expected marker < "$STATE/$role.pid" || return 1
    local cmd
    cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
    case "$role" in
        labwc) [[ "$cmd" == *"/labwc"* || "$cmd" == "labwc "* ]] ;;
        xwayland) [[ "$cmd" == *"/Xwayland"* || "$cmd" == "Xwayland "* ]] ;;
        xfce) [[ "$cmd" == *"dbus-run-session"* || "$cmd" == *"/xfce4-session"* ]] ;;
        clipboard) [[ "$cmd" == *"/clipboard-broker.sh"* ]] ;;
        ime) [[ "$cmd" == *"/alroot-ime-server"* ]] ;;
        *) return 1 ;;
    esac
}

record_pid() {
    local name="$1" pid="$2"
    local start
    start="$(process_start_ticks "$pid")" || {
        echo "Cannot inspect started $name PID $pid" >&2
        return 1
    }
    printf '%s %s alroot-wayland\n' "$pid" "$start" > "$STATE/$name.pid"
}

socket_ready() {
    [[ -S "$1" ]] || return 1
    python3 -c 'import socket,sys
s=socket.socket(socket.AF_UNIX)
s.settimeout(.3)
try: s.connect(sys.argv[1])
except OSError: sys.exit(1)
finally: s.close()' "$1" >/dev/null 2>&1
}

wait_socket() {
    local name="$1" i
    for ((i=0; i<90; ++i)); do
        if socket_ready "$RUNTIME/$name"; then return 0; fi
        sleep .2
    done
    return 1
}

wait_nested_socket() {
    local i path parent
    for ((i=0; i<90; ++i)); do
        for path in "$RUNTIME"/wayland-*; do
            [[ -S "$path" && "$path" != "$RUNTIME/wayland-0" ]] || continue
            if socket_ready "$path"; then
                parent="${path##*/}"
                printf '%s\n' "$parent" > "$STATE/labwc-socket"
                printf '%s\n' "$parent"
                return 0
            fi
        done
        owned_pid_active labwc || return 1
        sleep .2
    done
    return 1
}

# A running XFCE PID is insufficient. On Xfce 4.20 some components may choose
# Wayland instead of the rootful X11 session, leaving the Android view black.
# Prove the actual X11 WM, xfdesktop and panel on the *isolated* DISPLAY.
x11_desktop_ready() {
    local display="" list="" id="" props="" wm="" desktop=0 panel=0
    [[ -r "$STATE/display" && -r "$STATE/Xauthority" ]] || return 1
    IFS= read -r display < "$STATE/display"
    [[ "$display" =~ ^:[0-9]{1,3}$ && "$display" != :0 ]] || return 1
    alive xwayland && alive xfce || return 1
    wm="$(env -u WAYLAND_DISPLAY DISPLAY="$display" XAUTHORITY="$STATE/Xauthority" \
            timeout 2 xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null)" || return 1
    [[ "$wm" == *"window id #"* ]] || return 1
    list="$(env -u WAYLAND_DISPLAY DISPLAY="$display" XAUTHORITY="$STATE/Xauthority" \
            timeout 2 xprop -root _NET_CLIENT_LIST 2>/dev/null)" || return 1
    list="${list#*# }"
    for id in ${list//,/ }; do
        [[ "$id" =~ ^0x[0-9a-fA-F]+$ ]] || continue
        props="$(env -u WAYLAND_DISPLAY DISPLAY="$display" XAUTHORITY="$STATE/Xauthority" \
                timeout 2 xprop -id "$id" WM_CLASS 2>/dev/null)" || continue
        [[ "$props" == *'"Xfdesktop"'* ]] && desktop=1
        [[ "$props" == *'"Xfce4-panel"'* ]] && panel=1
    done
    ((desktop && panel))
}

xfce_start() {
    local display="$1"
    mkdir -p "$STATE/xfce-config" "$STATE/xfce-cache"
    # One-time profile snapshot: never write into the original settings.
    local config_name
    for config_name in xfce4 nimf fontconfig gtk-3.0 gtk-4.0 qt5ct qt6ct; do
        if [[ -e "$HOME/.config/$config_name" && ! -e "$STATE/xfce-config/$config_name" ]]; then
            cp -a "$HOME/.config/$config_name" "$STATE/xfce-config/"
        fi
    done
    # Project-only XFCE panel integration: Termux:API battery + Plank launcher.
    "$PREFIX/bin/python3" "$HOME/alroot_wayland/termux/configure-xfce-profile.py" \
        > "$LOGS/profile.log" 2>&1
    "$PREFIX/bin/bash" "$HOME/alroot_wayland/tools/install-alroot-proot-shims.sh" \
        >> "$LOGS/profile.log" 2>&1
    "$PREFIX/bin/python3" "$HOME/alroot_wayland/termux/configure-fastfetch.py" \
        >> "$LOGS/profile.log" 2>&1 ||
        echo 'WARNING: project fastfetch format override could not be prepared' >&2
    # P14: native Fcitx5 preedit is already correct, but VTE 0.84.1 hides
    # its ordinary caret during any IM preedit. A pinned LGPL VTE patch
    # draws the composing caret *only* for Alroot XFCE terminal. Its
    # native library/launcher are project-local; original Termux-X11 :0,
    # global libvte and other GTK clients are never modified.
    if [[ -f "$STATE/ime-fcitx-enabled" ]]; then
        local private_vte="$STATE/vte-private/libvte-2.91.so.0"
        local terminal_link="$STATE/bin/xfce4-terminal"
        local caret_patch="$HOME/alroot_wayland/termux/patches/vte-0.84.1-caret.patch"
        if [[ ! -s "$private_vte" || "$caret_patch" -nt "$private_vte" ||
              ! -L "$terminal_link" ]]; then
            "$PREFIX/bin/bash" "$HOME/alroot_wayland/termux/build-vte-caret.sh" \
                > "$LOGS/vte-caret-build.log" 2>&1 ||
                echo 'WARNING: Alroot-only VTE caret build unavailable; system terminal remains usable' >&2
        fi
    fi
    (
        # Only this Alroot XFCE session gets private mpd/mprun/pdrun wrappers.
        export HOME PREFIX PATH="$STATE/bin:$PREFIX/bin:$PREFIX/bin/applets"
        export DISPLAY="$display" XAUTHORITY="$STATE/Xauthority"
        export XDG_RUNTIME_DIR="$RUNTIME" XDG_CONFIG_HOME="$STATE/xfce-config"
        export XDG_CACHE_HOME="$STATE/xfce-cache" XDG_SESSION_TYPE=x11
        # Xfce 4.20/GTK4 can otherwise auto-select the available Wayland
        # socket in this isolated runtime despite DISPLAY pointing at Xwayland.
        # This is the *rootful X11 desktop*, NOT Labwc or the Android host.
        export GDK_BACKEND=x11 QT_QPA_PLATFORM=xcb SDL_VIDEODRIVER=x11
        if [[ -f "$STATE/ime-fcitx-enabled" ]]; then
            # Isolated Xwayland desktop only. GTK/Qt with native IM can
            # update actual preedit; other clients retain XTEST fallback.
            export GTK_IM_MODULE=fcitx QT_IM_MODULE=fcitx XMODIFIERS=@im=fcitx
            export FCITX_DATA_HOME="$STATE/fcitx-data"
            export FCITX_ADDON_DIRS="$STATE/fcitx-addon:$PREFIX/lib/fcitx5"
            export ALROOT_FCITX_BRIDGE_SOCKET="$STATE/ipc/ime-fcitx.sock"
        fi
        export DESKTOP_SESSION=xfce XDG_CURRENT_DESKTOP=XFCE
        unset WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS SESSION_MANAGER
        export NO_AT_BRIDGE=1
        # Separate process group so explicit stop can target this session's
        # descendants without signalling any pre-existing desktop session.
        exec setsid dbus-run-session -- "$PREFIX/bin/bash" \
            "$HOME/alroot_wayland/termux/alroot-xfce-session.sh"
    ) > "$LOGS/xfce.log" 2>&1 8>&- &
    record_pid xfce "$!"
}

clipboard_start() {
    if ! command -v xclip >/dev/null 2>&1 || ! command -v xdotool >/dev/null 2>&1; then
        echo 'BLOCKED: xclip and xdotool are required for X11 text input' >&2
        return 1
    fi
    (
        export HOME PREFIX PATH="$PREFIX/bin:$PREFIX/bin/applets"
        export XDG_RUNTIME_DIR="$RUNTIME"
        exec "$PREFIX/bin/bash" "$HOME/alroot_wayland/termux/clipboard-broker.sh" "$STATE" "$1"
    ) > "$LOGS/clipboard.log" 2>&1 8>&- &
    record_pid clipboard "$!"
}

ime_start() {
    local display="$1" binary="$HOME/alroot_wayland/packages/bin/alroot-ime-server"
    if ! "$PREFIX/bin/bash" "$HOME/alroot_wayland/termux/build-ime-server.sh" \
            > "$LOGS/ime-build.log" 2>&1; then
        echo 'WARNING: IME native build failed; legacy queue fallback is available' >&2
        return 0
    fi
    (
        export DISPLAY="$display" XAUTHORITY="$STATE/Xauthority" \
               HOME PREFIX PATH="$PREFIX/bin:$PREFIX/bin/applets"
        if [[ -f "$STATE/ime-fcitx-enabled" ]]; then
            export ALROOT_FCITX_BRIDGE_SOCKET="$STATE/ipc/ime-fcitx.sock"
        fi
        exec "$binary" "$STATE/ipc/ime.sock"
    ) > "$LOGS/ime-server.log" 2>&1 8>&- &
    record_pid ime "$!"
}

start_xwayland() {
    local parent_display="$1" n
    export XDG_RUNTIME_DIR="$RUNTIME" WAYLAND_DISPLAY="$parent_display"
    export XAUTHORITY="$STATE/Xauthority"
    # Never inherit a pre-existing Termux-X11 :0 DISPLAY from the caller.
    unset DISPLAY
    for n in $(seq 90 180); do
        if [[ ! -e "$PREFIX/tmp/.X11-unix/X$n" && ! -e "$PREFIX/tmp/.X$n-lock" ]]; then
            break
        fi
    done
    [[ "$n" -le 180 ]] || { echo 'no unoccupied X DISPLAY' >&2; return 1; }
    : > "$XAUTHORITY"
    chmod 600 "$XAUTHORITY"
    local cookie
    cookie="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
    xauth -f "$XAUTHORITY" add ":$n" MIT-MAGIC-COOKIE-1 "$cookie" >/dev/null 2>&1
    unset cookie
    # Do not use -terminate: the xdpyinfo readiness probe is a short-lived
    # X11 client. With -terminate, the server exits before XFCE connects.
    # Native host and rootful Xwayland must use the SAME guest resolution.
    # Otherwise a 1280x720 desktop occupies only part of a 1920x1080 scene.
    local guest_w=1920 guest_h=1080 candidate_w="" candidate_h=""
    if [[ -r "$STATE/output-resolution" ]]; then
        read -r candidate_w candidate_h < "$STATE/output-resolution" || true
        if [[ "$candidate_w" =~ ^[0-9]{3,4}$ && "$candidate_h" =~ ^[0-9]{3,4}$ ]] &&
            ((candidate_w >= 320 && candidate_w <= 3840 &&
              candidate_h >= 240 && candidate_h <= 2160)); then
            guest_w="$candidate_w"; guest_h="$candidate_h"
        fi
    fi
    printf '%s %s\n' "$guest_w" "$guest_h" > "$STATE/x11-geometry"
    # GPU backend selection is session-wide, never XFCE-only. The default
    # global Termux Xwayland stays untouched until a private GPU build has
    # passed framebuffer import and presentation tests. This opt-in path can
    # support any Xwayland desktop, irrespective of its window-manager.
    local xwayland_binary="$PREFIX/bin/Xwayland" candidate="" glamor=""
    local -a xwayland_gpu_args=()
    if [[ -n "${ALROOT_XWAYLAND_BINARY:-}" ]]; then
        candidate="$(realpath -- "${ALROOT_XWAYLAND_BINARY}")"
        if [[ ! -x "$candidate" ||
              ( "$candidate" != "$HOME/alroot_wayland/.source/gpu-stage1/"* &&
                "$candidate" != "$HOME/alroot_wayland/graphics/bin/"* ) ]]; then
            echo "Refusing unvalidated Xwayland binary outside Alroot graphics project: $candidate" >&2
            return 1
        fi
        xwayland_binary="$candidate"
        glamor="${ALROOT_XWAYLAND_GLAMOR:-off}"
        case "$glamor" in
        off|es|gl) xwayland_gpu_args=(-glamor "$glamor") ;;
        *) echo "Invalid ALROOT_XWAYLAND_GLAMOR=$glamor (expected off/es/gl)" >&2; return 1 ;;
        esac
        echo "[Alroot GPU] PRIVATE Xwayland: $xwayland_binary (GLAMOR=$glamor; not the Termux default)"
    fi
    if [[ "${ALROOT_XWAYLAND_DUAL_ABI_FENCE:-0}" == 1 ]]; then
        # Opt-in ONLY for the private Android KGSL Xwayland GLAMOR server.
        # Termux-native DRI3 xshmfence uses a 96-byte Bionic pthread
        # structure, while Debian glibc DRI3 uses a 4-byte futex word.
        # A private xshmfence interposer prevents cross-libc FORTIFY
        # aborts and is never preloaded into the user shell, glibc client,
        # Android APK, global Termux-X11 or generic GPU vendors.
        local dualabi="$HOME/alroot_wayland/.source/gpu-stage27-pr25/s16-xwayland-gpu/xshmfence/libalroot_xshmfence_dualabi.so"
        source "$HOME/alroot_wayland/termux/xwayland-gpu-profile.sh"
        alroot_validate_kgsl_profile "$xwayland_binary" "$glamor" "$HOME/alroot_wayland" || return 1
        echo '[Alroot GPU] PRIVATE Xwayland xshmfence Bionic96/glibc4 compatibility enabled'
        env LD_PRELOAD="$dualabi${LD_PRELOAD:+ $LD_PRELOAD}" \
            S16_XSHMFENCE_TRACE="${S16_XSHMFENCE_TRACE:-1}" \
            "$xwayland_binary" ":$n" "${xwayland_gpu_args[@]}" -geometry "${guest_w}x${guest_h}" -dpi 96 \
            -auth "$XAUTHORITY" -nolisten tcp \
            > "$LOGS/xwayland.log" 2>&1 8>&- &
    else
        "$xwayland_binary" ":$n" "${xwayland_gpu_args[@]}" -geometry "${guest_w}x${guest_h}" -dpi 96 \
            -auth "$XAUTHORITY" -nolisten tcp \
            > "$LOGS/xwayland.log" 2>&1 8>&- &
    fi
    record_pid xwayland "$!"
    local i
    for ((i=0; i<90; ++i)); do
        if DISPLAY=":$n" xdpyinfo -display ":$n" >/dev/null 2>&1; then
            printf ':%d\n' "$n" > "$STATE/display"
            # The Android app cannot reliably inspect another process's
            # /proc PID start time under Android SELinux. Publish an owned,
            # session-scoped marker only after the X socket really responds.
            printf ':%d\n' "$n" > "$STATE/ime-active"
            chmod 600 "$STATE/ime-active"
            echo "Xwayland :$n ready at ${guest_w}x${guest_h} 96DPI"
            return 0
        fi
        if ! owned_pid_active xwayland; then
            tail -15 "$LOGS/xwayland.log" >&2
            return 1
        fi
        sleep .2
    done
    echo 'Xwayland did not accept authenticated X11 connection' >&2
    return 1
}

start_session() {
    local profile="$1" preferred_ime="fcitx"
    [[ "$profile" == xfce-labwc || "$profile" == xfce-shm-direct ]] || {
        echo "Unsupported profile: $profile" >&2; return 2;
    }
    # S1.7: this lock is startup-only. Before the fix, background Xwayland,
    # the clipboard broker and the IME process INHERITED fd 8 across exec.
    # If a deadlocked X server survived --stop, it kept the flock on this
    # inode for hours and blocked all new sessions with a black helper view.
    # Every long-running child closes fd 8 at spawn; the parent retains it
    # only while installing one startup state and explicitly unlocks below.
    exec 8>"$STATE/start.lock"
    flock -n 8 || { echo 'another Alroot startup is active' >&2; exec 8>&-; return 1; }
    control_event START_BEGIN
    if alive xwayland || alive xfce || alive labwc || alive clipboard || alive ime; then
        echo 'Existing Alroot session found; run status or stop first' >&2; return 1
    fi
    # S25 S26U-only experimental CPU-scheduling/renderer A/B:
    # The helper Activity clears caller environment variables before
    # starting the Termux session. Consume a trusted, one-shot private
    # marker to carry *only* our hard-coded, prevalidated KGSL Xwayland
    # profile across the foreground Activity process boundary. Never
    # enable a GPU backend from the ordinary/default awstart invocation.
    local s25_marker="$STATE/control/s25-kgsl-topapp-once" s25_mode="" s25_age=0
    if [[ -e "$s25_marker" || -L "$s25_marker" ]]; then
        if [[ "$profile" != xfce-shm-direct || -L "$s25_marker" ||
              ! -f "$s25_marker" ||
              "$(stat -c '%u:%a' "$s25_marker" 2>/dev/null)" != "$(id -u):600" ||
              "$(/system/bin/getprop ro.product.model)" != SM-S948* ]]; then
            echo 'S25 KGSL top-app marker rejected: wrong profile/device or unsafe file' >&2
            return 1
        fi
        IFS= read -r s25_mode < "$s25_marker" || true
        s25_age=$(( $(date +%s) - $(stat -c %Y "$s25_marker") ))
        if [[ "$s25_mode" != S25_KGSL_TOPAPP_ONCE ||
              "$s25_age" -lt 0 || "$s25_age" -gt 90 ]]; then
            echo 'S25 KGSL top-app marker invalid/expired; refusing fallback' >&2
            return 1
        fi
        local s25_xwayland="$HOME/alroot_wayland/.source/gpu-stage1/xwayland-kgsl/build/hw/xwayland/Xwayland"
        local s25_dualabi="$HOME/alroot_wayland/.source/gpu-stage27-pr25/s16-xwayland-gpu/xshmfence/libalroot_xshmfence_dualabi.so"
        if [[ ! -x "$s25_xwayland" || ! -s "$s25_dualabi" ]]; then
            echo 'S25 KGSL top-app marker missing private GPU binaries; refusing fallback' >&2
            return 1
        fi
        # Already started from a launcher that supplied a different backend?
        # Do not overwrite its environment or silently change the renderer.
        if [[ -n "${ALROOT_XWAYLAND_BINARY:-}" ||
              -n "${ALROOT_XWAYLAND_GLAMOR:-}" ]]; then
            echo 'S25 KGSL top-app marker conflicts with custom GPU environment' >&2
            return 1
        fi
        rm -f -- "$s25_marker"
        export ALROOT_XWAYLAND_BINARY="$s25_xwayland"
        export ALROOT_XWAYLAND_GLAMOR=es
        export ALROOT_XWAYLAND_DUAL_ABI_FENCE=1
        export XWAYLAND_FORCE_KGSL_SURFACELESS=1
        export FD_KGSL_ENABLE_DMABUF=1
        export MESA_LOADER_DRIVER_OVERRIDE=kgsl
        export GALLIUM_DRIVER=freedreno
        echo '[S25] ONE-SHOT private KGSL Xwayland selected from foreground helper; default path unchanged'
    fi
    # Refuse to attach to an unexpected nested socket from a previous session.
    local path
    for path in "$RUNTIME"/wayland-*; do
        [[ -S "$path" && "$path" != "$RUNTIME/wayland-0" ]] || continue
        if socket_ready "$path"; then
            echo "BLOCKED: unexpected nested Wayland socket already in use: $path" >&2
            return 1
        fi
    done
    # Failed intermediate stages must not leave project-owned processes alive.
    rm -f "$STATE/ime-active"
    # Every cleanup role is attempted even when an earlier TERM does not
    # stop a process promptly. Otherwise `set -e` can abort this EXIT trap
    # halfway through and leave a private Xwayland running without XFCE.
    trap 'rc=$?; if ((rc != 0)); then control_event START_ROLLBACK; for r in ime clipboard xfce xwayland labwc; do stop_one "$r" || true; done; fi' EXIT
    if ! wait_socket wayland-0; then
        echo "BLOCKED: Android helper socket $RUNTIME/wayland-0 is not accepting connections" >&2
        return 1
    fi
    mkdir -p "$STATE/ipc"
    chmod 700 "$STATE/ipc"
    # A newly started project session cannot inherit an obsolete X11 selection.
    rm -f "$STATE/ipc/x11-to-android.txt" "$STATE/ipc/.last-injected.txt"
    if [[ -d "$STATE/ipc/ime-requests" ]]; then
        find "$STATE/ipc/ime-requests" -maxdepth 1 -type f -name '*.commit' -delete
        find "$STATE/ipc/ime-requests" -maxdepth 1 -type f -name '*.delete' -delete
    fi
    echo "$profile" > "$STATE/profile"
    # Match the actual XFCE cursor from the moment the private Xwayland (and
    # nested Labwc, if used) first acquires the seat. Without this, an early
    # generic Wayland/X11 pointer appears before xfsettingsd applies its
    # configured theme. Scope the variables to this Alroot session only.
    local cursor_settings="" cursor_theme="" cursor_size=""
    if cursor_settings="$("$PREFIX/bin/python3" \
            "$HOME/alroot_wayland/termux/xfce-cursor-env.py" 2>/dev/null)" &&
            [[ -n "$cursor_settings" ]]; then
        IFS=$'\t' read -r cursor_theme cursor_size <<< "$cursor_settings"
        if [[ "$cursor_theme" =~ ^[a-zA-Z0-9_+.-]{1,128}$ &&
              "$cursor_size" =~ ^[0-9]{1,3}$ ]] &&
              ((cursor_size >= 8 && cursor_size <= 256)); then
            export XCURSOR_THEME="$cursor_theme" XCURSOR_SIZE="$cursor_size"
            echo "Alroot XFCE startup cursor: $XCURSOR_THEME size=$XCURSOR_SIZE"
        fi
    fi
    local parent=wayland-0
    if [[ "$profile" == xfce-labwc ]]; then
        command -v labwc >/dev/null || { echo 'BLOCKED: no Termux labwc' >&2; return 1; }
        mkdir -p "$STATE/labwc-config"
        (
            export HOME PREFIX PATH="$PREFIX/bin:$PREFIX/bin/applets"
            export XDG_RUNTIME_DIR="$RUNTIME" WAYLAND_DISPLAY=wayland-0
            export WLR_BACKENDS=wayland WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1
            export XDG_CONFIG_HOME="$STATE/xfce-config"
            if [[ -r "$HOME/alroot_wayland/packages/prefix/lib/libwlroots-0.18.so" ]]; then
                export LD_LIBRARY_PATH="$HOME/alroot_wayland/packages/prefix/lib"
            fi
            unset DISPLAY DBUS_SESSION_BUS_ADDRESS
            exec labwc -C "$STATE/labwc-config"
        ) > "$LOGS/labwc.log" 2>&1 8>&- &
        record_pid labwc "$!"
        if ! parent="$(wait_nested_socket)"; then
            echo 'BLOCKED: Labwc Wayland backend did not start (nested socket missing)' >&2
            tail -16 "$LOGS/labwc.log" >&2
            return 1
        fi
        # The nested wlroots backend defaults to 1280x720 even though the
        # parent and Xwayland use 1920x1080. Upscaling this 720p scene
        # to the full phone height makes XFCE look ~1.5x larger at 96 DPI.
        # Resize only private Labwc WL-1 before Xwayland/XFCE start.
        # Wayland nested backend rejects refresh values in custom modes.
        local nested_w=1920 nested_h=1080 candidate_w="" candidate_h=""
        if [[ -r "$STATE/output-resolution" ]]; then
            read -r candidate_w candidate_h < "$STATE/output-resolution" || true
            if [[ "$candidate_w" =~ ^[0-9]{3,4}$ && "$candidate_h" =~ ^[0-9]{3,4}$ ]] &&
                ((candidate_w >= 320 && candidate_w <= 3840 &&
                  candidate_h >= 240 && candidate_h <= 2160)); then
                nested_w="$candidate_w"; nested_h="$candidate_h"
            fi
        fi
        rm -f "$STATE/labwc-geometry"
        if ! "$PREFIX/bin/bash" "$HOME/alroot_wayland/termux/build-nested-output.sh" \
                > "$LOGS/nested-output-build.log" 2>&1; then
            echo 'WARNING: project-only Labwc output helper failed to build' >&2
        else
            local nested_ok=0 attempt
            for ((attempt=0; attempt<25; ++attempt)); do
                if env XDG_RUNTIME_DIR="$RUNTIME" WAYLAND_DISPLAY="$parent" \
                    "$HOME/alroot_wayland/packages/bin/alroot-nested-output" \
                    "$nested_w" "$nested_h" > "$LOGS/nested-output.log" 2>&1; then
                    nested_ok=1
                    break
                fi
                sleep .12
            done
            if ((nested_ok)); then
                printf '%s %s\n' "$nested_w" "$nested_h" > "$STATE/labwc-geometry"
                echo "Nested Labwc $parent: $nested_w x $nested_h (X11 DPI 96)"
            else
                echo 'WARNING: nested Labwc output resize failed; see nested-output.log' >&2
            fi
        fi
    fi
    start_xwayland "$parent"
    rm -f "$STATE/ime-fcitx-enabled" "$STATE/ipc/ime-fcitx.sock"
    if [[ -r "$STATE/ime-backend" ]]; then
        IFS= read -r preferred_ime < "$STATE/ime-backend" || true
    fi
    preferred_ime="${ALROOT_IME_BACKEND:-$preferred_ime}"
    if [[ "$preferred_ime" != fcitx && "$preferred_ime" != xtest ]]; then
        echo 'WARNING: invalid private IME preference; using XTEST' >&2
        preferred_ime=xtest
    fi
    if [[ "$preferred_ime" == fcitx ]]; then
        if "$PREFIX/bin/bash" "$HOME/alroot_wayland/termux/build-fcitx-bridge.sh" \
                > "$LOGS/ime-fcitx-build.log" 2>&1; then
            touch "$STATE/ime-fcitx-enabled"
            chmod 600 "$STATE/ime-fcitx-enabled"
        else
            echo 'WARNING: Fcitx native bridge build unavailable; use XTEST' >&2
        fi
    fi
    echo "IME route requested: $preferred_ime (XTEST fallback available)"
    ime_start "$(cat "$STATE/display")"
    xfce_start "$(cat "$STATE/display")"
    clipboard_start "$(cat "$STATE/display")"
    sleep .6
    if ! alive xfce; then
        echo 'FAIL: XFCE exited immediately' >&2
        tail -16 "$LOGS/xfce.log" >&2
        return 1
    fi
    if [[ -r "$HOME/alroot_wayland/termux/alroot-refresh-sync.py" ]]; then
        # Xwayland answers xdpyinfo before its RandR output lifecycle has
        # settled. The old early --newmode could show up on disconnected
        # WL-1 only and --addmode then failed. Wait until the isolated X11
        # desktop has a real WM/panel before attaching its physical-rate mode.
        local attempt
        for ((attempt=0; attempt<35; ++attempt)); do
            x11_desktop_ready && break
            sleep .2
        done
        "$PREFIX/bin/python3" "$HOME/alroot_wayland/termux/alroot-refresh-sync.py" \
            > "$LOGS/refresh.log" 2>&1 ||
            echo 'WARNING: XRandR refresh sync failed; see refresh.log' >&2
    fi
    echo "Alroot $profile started on $(cat "$STATE/display")"
    control_event START_READY
    # A successful startup must NEVER retain the flock in child processes.
    # In particular, a subsequently hung Xwayland must not block recovery.
    flock -u 8
    exec 8>&-
    trap - EXIT
}

stop_one() {
    local role="$1" pid=""
    if owned_pid_active "$role"; then
        read -r pid _ < "$STATE/$role.pid"
        # This must not signal its OWN process group; doing so can interrupt
        # the remaining stop steps and leave the Xwayland server behind.
        local self_pgid="" mode="pid"
        self_pgid="$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')"
        if [[ "$role" == xfce ]] && isolated_session_leader "$pid"; then
            if [[ "$self_pgid" == "$pid" ]]; then
                echo "BLOCKED: stop would kill its own XFCE session group $pid" >&2
                return 2
            fi
            mode=group
            kill -TERM -- "-$pid" 2>/dev/null || true
        else
            kill -TERM "$pid" 2>/dev/null || true
        fi
        echo "signalled Alroot $role pid $pid"
        local attempt
        for ((attempt=0;attempt<24;++attempt));do
            owned_pid_active "$role" || break
            sleep .1
        done
        if owned_pid_active "$role";then
            echo "Alroot $role did not exit on TERM; killing only verified project-owned $mode $pid" >&2
            if [[ "$mode" == group ]];then
                kill -KILL -- "-$pid" 2>/dev/null || true
            else
                kill -KILL "$pid" 2>/dev/null || true
            fi
            for ((attempt=0;attempt<12;++attempt));do
                owned_pid_active "$role" || break
                sleep .1
            done
        fi
        if owned_pid_active "$role";then
            echo "FAILED: Alroot $role $pid still alive; preserving PID record for safe recovery" >&2
            return 1
        fi
    fi
    rm -f "$STATE/$role.pid"
}

stop_session() {
    # Mutual exclusion with the startup-only lock prevents a stop from
    # killing a half-launched desktop and accidentally leaving Xwayland.
    exec 8>"$STATE/start.lock"
    flock -w 25 8 || { echo 'BLOCKED: an Alroot session is starting; stop lock timed out' >&2; exec 8>&-; return 2; }
    control_event STOP_BEGIN
    rm -f "$STATE/ime-active" "$STATE/ime-fcitx-enabled" "$STATE/labwc-geometry"
    local failed=0 role
    for role in ime clipboard xfce xwayland labwc;do
        stop_one "$role" || failed=1
    done
    if ((failed));then
        control_event STOP_INCOMPLETE
        echo 'Alroot stop incomplete: owned PID marker kept where process survived' >&2
        flock -u 8
        exec 8>&-
        return 1
    fi
    rm -f "$STATE/display" "$STATE/labwc-socket"
    control_event STOP_COMPLETE
    flock -u 8
    exec 8>&-
}

case "${1:-}" in
    start)
        [[ "${2:-}" == --profile && -n "${3:-}" ]] || { usage; exit 2; }
        start_session "$3"
        ;;
    status)
        echo "host: $RUNTIME/wayland-0 $(socket_ready "$RUNTIME/wayland-0" && echo READY || echo DOWN)"
        for role in labwc xwayland xfce clipboard ime; do
            if alive "$role"; then echo "$role: RUNNING $(cut -d' ' -f1 "$STATE/$role.pid")"
            else echo "$role: DOWN"; fi
        done
        if [[ -f "$STATE/ime-fcitx-enabled" ]]; then
            if [[ -S "$STATE/ipc/ime-fcitx.sock" ]]; then
                echo 'ime_frontend: NATIVE_FCITX (ready; XTEST fallback supported)'
            else
                echo 'ime_frontend: NATIVE_FCITX (waiting; XTEST fallback)'
            fi
        else
            echo 'ime_frontend: XTEST (legacy)'
        fi
        [[ ! -r "$STATE/ime-backend" ]] ||
            echo "ime_preference: $(cat "$STATE/ime-backend")"
        [[ ! -r "$STATE/labwc-geometry" ]] ||
            echo "labwc_geometry: $(cat "$STATE/labwc-geometry") (X11 DPI 96)"
        if [[ -f "$STATE/ime-fcitx-enabled" &&
              -s "$STATE/vte-private/libvte-2.91.so.0" &&
              -L "$STATE/bin/xfce4-terminal" ]]; then
            echo 'xfce_terminal_caret: PRIVATE_VTE_0.84.1 (native Hangul preedit cursor)'
        else
            echo 'xfce_terminal_caret: SYSTEM_VTE (no scoped cursor override)'
        fi
        if x11_desktop_ready; then
            echo 'x11_desktop: READY (xfwm4 + xfdesktop + xfce4-panel on isolated Xwayland)'
        else
            echo 'x11_desktop: INCOMPLETE (X11 window-manager/desktop/panel not verified)'
        fi
        [[ ! -f "$STATE/profile" ]] || echo "profile: $(cat "$STATE/profile")"
        [[ ! -f "$STATE/display" ]] || echo "X DISPLAY: $(cat "$STATE/display")"
        ;;
    stop)
        stop_session
        ;;
    open)
        am start -n com.alroot.wayland/.MainActivity
        ;;
    logs)
        for f in "$LOGS"/{labwc,nested-output,nested-output-build,xwayland,xfce,clipboard,ime-server,ime-build,ime-fcitx-build,vte-caret-build,refresh,upower}.log "$STATE/spawn.log"; do
            if [[ -r "$f" ]]; then echo "--- $f"; tail -24 "$f"; fi
        done
        ;;
    doctor)
        echo "Termux uid: $(id -u)"
        for tool in labwc Xwayland xfce4-session dbus-run-session xauth python3; do
            if command -v "$tool" >/dev/null 2>&1; then echo "$tool: $(command -v "$tool")"
            else echo "$tool: MISSING"; fi
        done
        if command -v labwc >/dev/null 2>&1; then
            if [[ -r "$HOME/alroot_wayland/packages/prefix/lib/libwlroots-0.18.so" ]]; then
                LD_LIBRARY_PATH="$HOME/alroot_wayland/packages/prefix/lib" labwc -h 2>&1 | head -4 || true
            else
                labwc -h 2>&1 | head -4 || true
            fi
        fi
        if [[ -d "$RUNTIME" ]]; then stat -c 'runtime permissions: %a' "$RUNTIME"; fi
        ;;
    *)
        usage; exit 2 ;;
esac
