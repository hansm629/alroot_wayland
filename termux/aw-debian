#!/data/data/com.termux/files/usr/bin/bash
# Alroot-only Debian shell; never replaces the native Termux debian launcher.
# Within the Alroot XFCE session the private PATH shadows the debian name.
set -euo pipefail
HOME=/data/data/com.termux/files/home
PREFIX=/data/data/com.termux/files/usr
STATE="$HOME/.alroot-wayland"
[[ -r "$STATE/display" && -r "$STATE/Xauthority" &&
   -r "$STATE/ime-active" ]] || {
    echo 'Alroot Debian: start Alroot Wayland first (awstart)' >&2
    exit 1
}
IFS= read -r display < "$STATE/display"
[[ "$display" =~ ^:[0-9]{1,3}$ && "$display" != :0 &&
   "$(cat "$STATE/ime-active")" == "$display" ]] || {
    echo 'Alroot Debian: invalid isolated X11 display/marker' >&2
    exit 1
}
if (($#)); then
    if [[ "$1" == fastfetch || "$1" == /usr/bin/fastfetch ]]; then
        shift
        exec "$PREFIX/bin/aw-pdrun" /usr/bin/fastfetch --config \
            /data/data/com.termux/files/home/.alroot-wayland/fastfetch/config.jsonc "$@"
    fi
    exec "$PREFIX/bin/aw-pdrun" "$@"
fi
# The private rc sources Debian's existing settings then restores the
# Alroot-specific display and auth. No modifications to rootfs .bashrc.
exec "$PREFIX/bin/aw-pdrun" /bin/bash --rcfile \
    /data/data/com.termux/files/home/alroot_wayland/termux/alroot-debian-bashrc -i
